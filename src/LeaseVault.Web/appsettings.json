{
  "ConnectionStrings": {
    "Default": ""
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc",
    "Groups": {
      "Agents": "",
      "Legal": "",
      "Owners": "",
      "Admins": ""
    }
  },
  "Storage": {
    "AccountUri": "",
    "ConnectionString": "",
    "ContainerName": "documents",
    "LocalPath": "App_Data/storage",
    "BlockSizeBytes": 4194304
  },
  "Search": {
    "DisableFts5": false,
    "MaxFacetValues": 20
  },
  "Approvals": {
    "StepSlaHours": 48,
    "EscalationPollMinutes": 15,
    "DefaultAgent": "agent@leasevault.local",
    "DefaultLegal": "legal@leasevault.local",
    "DefaultOwner": "owner@leasevault.local",
    "FallbackOwner": "admin@leasevault.local"
  },
  "Reminders": {
    "LeadDays": 60,
    "PollMinutes": 60,
    "NotifyAddress": "leasing@leasevault.local"
  },
  "Retention": {
    "Enabled": true,
    "PollHours": 24
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
