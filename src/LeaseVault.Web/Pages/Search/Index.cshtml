@page
@model LeaseVault.Web.Pages.Search.IndexModel
@{
    ViewData["Title"] = "Search";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Search documents</h1>
    <span class="text-muted small">engine: <code id="provider">@Model.Provider</code></span>
</div>
<div class="row g-3">
    <div class="col-lg-3">
        <div class="input-group mb-3">
            <input id="q" type="search" class="form-control" placeholder="lease renewal, insurance, warehouse…" autofocus />
            <button id="go" class="btn btn-primary" type="button"><i class="bi bi-search"></i></button>
        </div>
        <div class="mb-2">
            <label class="form-label small mb-1">Status</label>
            <select id="status" class="form-select form-select-sm"><option value="">Any</option>@foreach (var s in Model.Statuses) { <option>@s</option> }</select>
        </div>
        <div class="mb-3">
            <label class="form-label small mb-1">Category</label>
            <select id="category" class="form-select form-select-sm"><option value="">Any</option>@foreach (var c in Model.Categories) { <option>@c</option> }</select>
        </div>
        <div id="facets">
            <h2 class="h6">Property</h2><ul class="list-group facet-list mb-3" data-facet="propertyId"></ul>
            <h2 class="h6">Tenant</h2><ul class="list-group facet-list mb-3" data-facet="tenantId"></ul>
            <h2 class="h6">Tag</h2><ul class="list-group facet-list mb-3" data-facet="tag"></ul>
            <h2 class="h6">Status</h2><ul class="list-group facet-list mb-3" data-facet="status"></ul>
        </div>
        <button id="clear" class="btn btn-outline-secondary btn-sm w-100">Clear filters</button>
    </div>
    <div class="col-lg-9">
        <table id="results" class="table table-striped table-hover w-100">
            <thead><tr><th>Title</th><th>Category</th><th>Property</th><th>Tenant</th><th>Tags</th><th>Ver</th><th>Status</th><th>Created</th><th>Rank</th></tr></thead>
        </table>
    </div>
</div>
@section Scripts {
<script>
(function ($) {
    var filters = { propertyId: '', tenantId: '', tag: '', status: '', category: '' };
    var table = $('#results').DataTable({
        serverSide: true,
        processing: true,
        searching: false,
        pageLength: 15,
        lengthMenu: [10, 15, 25, 50],
        ordering: false,
        ajax: {
            url: '/api/search',
            data: function (d) {
                d.q = $('#q').val();
                d.propertyId = filters.propertyId;
                d.tenantId = filters.tenantId;
                d.tag = filters.tag;
                d.status = filters.status || $('#status').val();
                d.category = $('#category').val();
            },
            dataSrc: function (json) { renderFacets(json.facets); $('#provider').text(json.provider); return json.data; }
        },
        columns: [
            { data: 'title', render: function (t, _, row) { return '<a href="/Documents/Details/' + row.id + '">' + $('<div>').text(t).html() + '</a>'; } },
            { data: 'category' },
            { data: 'property', defaultContent: '' },
            { data: 'tenant', defaultContent: '' },
            { data: 'tags', render: function (tags) { return (tags || []).map(function (t) { return '<span class="badge text-bg-info tag-badge me-1">' + $('<div>').text(t).html() + '</span>'; }).join(''); } },
            { data: 'version', render: function (v) { return 'v' + v; } },
            { data: 'status', render: function (s) { return '<span class="badge text-bg-light border">' + s + '</span>'; } },
            { data: 'createdUtc', render: function (d) { return d ? d.substring(0, 10) : ''; } },
            { data: 'rank', className: 'rank' }
        ]
    });

    function renderFacets(facets) {
        if (!facets) { return; }
        var map = { propertyId: facets.properties, tenantId: facets.tenants, tag: facets.tags, status: facets.statuses };
        $('#facets ul').each(function () {
            var $ul = $(this), name = $ul.data('facet');
            $ul.empty();
            (map[name] || []).forEach(function (f) {
                var active = String(filters[name]) === String(f.key);
                $('<li class="list-group-item' + (active ? ' active' : '') + '">')
                    .append($('<span>').text(f.label))
                    .append($('<span class="badge rounded-pill ' + (active ? 'text-bg-light' : 'text-bg-secondary') + '">').text(f.count))
                    .on('click', function () { filters[name] = active ? '' : f.key; table.ajax.reload(); })
                    .appendTo($ul);
            });
        });
    }

    $('#go').on('click', function () { table.ajax.reload(); });
    $('#q').on('keyup', function (e) { if (e.key === 'Enter') { table.ajax.reload(); } });
    $('#status, #category').on('change', function () { filters.status = ''; table.ajax.reload(); });
    $('#clear').on('click', function () { filters = { propertyId: '', tenantId: '', tag: '', status: '', category: '' }; $('#q').val(''); $('#status, #category').val(''); table.ajax.reload(); });
})(jQuery);
</script>
}
