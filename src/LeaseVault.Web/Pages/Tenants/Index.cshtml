@page
@model LeaseVault.Web.Pages.Tenants.IndexModel
@{
    ViewData["Title"] = "Tenants";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Tenants</h1>
    @if (CurrentUser.IsInGroup(GroupNames.Agents) || CurrentUser.IsInGroup(GroupNames.Admins))
    {
        <a class="btn btn-primary" asp-page="Create"><i class="bi bi-plus-lg me-1"></i>New tenant</a>
    }
</div>
<table class="table table-striped table-hover" data-table>
    <thead><tr><th>Name</th><th>Industry</th><th>Contact</th><th class="text-end">Leases</th><th class="text-end">Documents</th><th></th></tr></thead>
    <tbody>
    @foreach (var t in Model.Tenants)
    {
        <tr>
            <td>@t.Name</td>
            <td>@t.Industry</td>
            <td>@t.ContactEmail<br /><small class="text-muted">@t.ContactPhone</small></td>
            <td class="text-end">@t.Leases.Count</td>
            <td class="text-end">@t.Documents.Count</td>
            <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-page="Edit" asp-route-id="@t.Id">Edit</a></td>
        </tr>
    }
    </tbody>
</table>
