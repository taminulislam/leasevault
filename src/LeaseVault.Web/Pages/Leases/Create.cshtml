@page
@model LeaseVault.Web.Pages.Leases.CreateModel
@{
    ViewData["Title"] = "New lease";
}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-page="Index">Leases</a></li><li class="breadcrumb-item active">New</li></ol></nav>
<h1 class="h3">New lease</h1>
<form method="post" class="row g-3 col-lg-8">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-md-6"><label asp-for="Lease.UnitId" class="form-label">Unit</label><select asp-for="Lease.UnitId" asp-items="Model.UnitOptions" class="form-select"></select></div>
    <div class="col-md-6"><label asp-for="Lease.TenantId" class="form-label">Tenant</label><select asp-for="Lease.TenantId" asp-items="Model.TenantOptions" class="form-select"></select></div>
    <div class="col-md-3"><label asp-for="Lease.StartDate" class="form-label">Start</label><input asp-for="Lease.StartDate" type="date" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="Lease.EndDate" class="form-label">End</label><input asp-for="Lease.EndDate" type="date" class="form-control" /><span asp-validation-for="Lease.EndDate" class="text-danger small"></span></div>
    <div class="col-md-3"><label asp-for="Lease.MonthlyRent" class="form-label">Monthly rent</label><input asp-for="Lease.MonthlyRent" class="form-control" /><span asp-validation-for="Lease.MonthlyRent" class="text-danger small"></span></div>
    <div class="col-md-3"><label asp-for="Lease.SecurityDeposit" class="form-label">Deposit</label><input asp-for="Lease.SecurityDeposit" class="form-control" /></div>
    <div class="col-12"><label asp-for="Lease.Notes" class="form-label"></label><textarea asp-for="Lease.Notes" class="form-control" rows="3"></textarea></div>
    <div class="col-12"><button type="submit" class="btn btn-primary">Create</button> <a class="btn btn-link" asp-page="Index">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
