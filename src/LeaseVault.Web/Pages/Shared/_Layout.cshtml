@inject LeaseVault.Core.Abstractions.IDocumentStorage Storage
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LeaseVault</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom mb-3">
        <div class="container-fluid">
            <a class="navbar-brand fw-semibold" asp-page="/Index"><i class="bi bi-safe2 me-1"></i>LeaseVault</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                @if (CurrentUser.IsAuthenticated)
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Documents/Index">Documents</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Search/Index">Search</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Approvals/Index">Approvals</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Leases/Index">Leases</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Properties/Index">Properties</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Tenants/Index">Tenants</a></li>
                        @if (CurrentUser.IsInGroup(GroupNames.Admins))
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Retention/Index">Retention</a></li>
                        }
                        <li class="nav-item"><a class="nav-link" asp-page="/Audit/Index">Audit</a></li>
                    </ul>
                    <span class="navbar-text me-3 small">
                        <i class="bi bi-person-circle me-1"></i>@CurrentUser.DisplayName
                        @foreach (var g in CurrentUser.Groups)
                        {
                            <span class="badge text-bg-secondary ms-1">@g</span>
                        }
                    </span>
                    <a class="btn btn-outline-light btn-sm" href="@AuthMode.SignOutPath">Sign out</a>
                }
                else
                {
                    <ul class="navbar-nav me-auto"></ul>
                    <a class="btn btn-outline-light btn-sm" href="@AuthMode.SignInPath">Sign in</a>
                }
            </div>
        </div>
    </nav>
</header>
<div class="container-fluid px-4">
    <main role="main" class="pb-4">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">@success<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
        }
        @RenderBody()
    </main>
</div>
<footer class="border-top footer text-muted small">
    <div class="container-fluid px-4 py-2 d-flex justify-content-between flex-wrap">
        <span>&copy; @DateTime.UtcNow.Year LeaseVault &middot; lease &amp; document workflow repository</span>
        <span>Storage: <code>@Storage.ProviderName</code> &middot; Auth: <code>@(AuthMode.UsesEntraId ? "Entra ID" : "Dev cookie")</code> &middot; <a href="/health">health</a></span>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js" crossorigin="anonymous"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js" crossorigin="anonymous"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
